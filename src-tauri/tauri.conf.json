{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unArchive",
  "version": "0.2.2",
  "identifier": "com.ryanonmars.unarchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "unArchive",
        "width": 1100,
        "height": 640,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "unArchive-shortcut-v0.1.4.ico"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTRCMTU3ODMwRjc2RTMKUldUamRnK0RWN0VVdlB1WnlkMEpEYjJZY1hweGE0ODhzUXFqb0ExdHhZRzlQREwwdnFJS0k2YW0K",
      "endpoints": [
        "https://github.com/ryanonmars/unArchive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
